---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you requested does not exist.">
  <section class="space-y-4 py-8">
    <h1 class="text-2xl font-semibold text-zinc-50">404</h1>
    <p class="text-zinc-400">That URL is missing. Try the <a href="/">home page</a> or the <a href="/blog/">blog</a>.</p>
  </section>
</BaseLayout>
