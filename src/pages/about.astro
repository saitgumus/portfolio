---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="About"
  description="Background, focus areas, and how to reach me — Sait Gumus."
>
  <article class="space-y-8">
    <header class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-50">About</h1>
      <p class="text-lg text-zinc-400">A concise bio you can tailor to your story.</p>
    </header>
    <div
      class="space-y-4 text-base leading-relaxed text-zinc-300 [&_strong]:font-semibold [&_strong]:text-zinc-100"
    >
      <p>
        I’m <strong>Sait Gumus</strong> — replace this paragraph with your experience, domains you care about (backend,
        frontend, infra, data), and the kinds of problems you like solving.
      </p>
      <p>
        I keep notes and longer write-ups in the <a href="/blog/">blog</a>. For code, see <a href="/projects/">projects</a>{" "}
        or GitHub.
      </p>
      <p>
        <strong>Contact:</strong> add your email or social links here (or remove this line until you are ready).
      </p>
    </div>
  </article>
</BaseLayout>
