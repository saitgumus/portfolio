---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormatDate from "@/components/FormatDate.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

const blogFilter = ({ data }: CollectionEntry<"blog">) =>
  import.meta.env.DEV || !data.draft;

export async function getStaticPaths() {
  const posts = await getCollection("blog", blogFilter);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8 space-y-4 border-b border-zinc-800 pb-8">
      <p class="text-sm text-zinc-500">
        Published <FormatDate date={pubDate} />
        {
          updatedDate && (
            <>
              <span class="mx-2" aria-hidden="true">
                ·
              </span>
              Updated <FormatDate date={updatedDate} />
            </>
          )
        }
      </p>
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-50 sm:text-4xl">{title}</h1>
      <p class="text-lg text-zinc-400">{description}</p>
      {
        tags.length > 0 && (
          <p class="text-sm text-zinc-600">
            {tags.map((t) => (
              <span class="mr-2 inline-block rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-300">
                {t}
              </span>
            ))}
          </p>
        )
      }
    </header>
    <div
      class="article-content space-y-4 text-base leading-relaxed text-zinc-300 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-zinc-100 [&_li]:mt-2 [&_ol]:list-decimal [&_ol]:pl-6 [&_p]:mt-4 [&_ul]:list-disc [&_ul]:pl-6"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
