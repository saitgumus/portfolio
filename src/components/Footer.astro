---
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-zinc-800/80">
  <div
    class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-10 text-sm text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6"
  >
    <p>&copy; {year} Sait Gumus. All rights reserved.</p>
    <p class="flex flex-wrap gap-x-4 gap-y-2">
      <a
        href="https://www.linkedin.com/in/saitgumus"
        class="text-zinc-400 no-underline hover:text-zinc-200"
        rel="noreferrer"
        target="_blank"
      >
        LinkedIn
      </a>
      <a href="/rss.xml" class="text-zinc-400 no-underline hover:text-zinc-200">RSS</a>
      <a
        href="https://github.com/saitgumus/portfolio"
        class="text-zinc-400 no-underline hover:text-zinc-200"
        rel="noreferrer"
        target="_blank"
      >
        Source
      </a>
    </p>
  </div>
</footer>
